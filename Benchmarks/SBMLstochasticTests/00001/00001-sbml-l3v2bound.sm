ctmc

const int MAX_AMOUNT = 200;

// Compartment size

// Model parameters
const double Lambda = 0.1; //
const double Mu = 0.11; //

// Species _X
const int _X_MAX = MAX_AMOUNT;
module _X

    _X : [0.._X_MAX] init 100;

		// Birth
		[Birth] _X <= _X_MAX-10 -> (_X' = _X + 1);
		// Death
		[Death] _X > 0 -> (_X' = _X - 1);

endmodule

// Reaction rates
module reaction_rates

		// Birth:  ->  _X -> _X
		[Birth] (Lambda * _X) > 0 -> (Lambda * _X) : true;

		// Death:  ->  _X ->
		[Death] (Mu * _X) > 0 -> (Mu * _X) : true;

endmodule

// Reward structures (one per species)
// Reward 1: _X
rewards "_X" true : _X; endrewards
